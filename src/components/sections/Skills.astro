---
import Section from "@/components/Section.astro";

// Note: Ensure your @cv data matches these keys exactly
import { skills } from "@cv";

import Python from "@/icons/python.astro";
import FastAPI from "@/icons/fastapi.astro";
import Docker from "@/icons/docker.astro";
import Terraform from "@/icons/terraform.astro";
import Kubernetes from "@/icons/kubernetes.astro";
import Linux from "@/icons/linux.astro";
import AWS from "@/icons/aws.astro";

const SKILLS_ICONS: Record<string, any> = {
    Python,
    FastAPI,
    Linux,
    Docker,
    Terraform,
    Kubernetes,
    AWS
};

const skillNameMap: any = {};
---

<Section title="Skills">
    <ul>
        {
            skills.map(({ name }) => {
                const iconName = skillNameMap[name] || name;
                const Icon = SKILLS_ICONS[iconName];

                return (
                    <li>
                        {Icon && <Icon />} <span>{name}</span>
                    </li>
                );
            })
        }
    </ul>
</Section>

<style>
    ul {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        padding: 0;
        list-style: none;
    }

    li {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 85px;
        height: 85px;
        background: #181825;
        border: 1px solid #313244;
        border-radius: 12px;
        color: #cdd6f4;
        font-size: 0.75rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    li:hover {
        background: #313244;
        border-color: #fab387;
        transform: translateY(-3px);
        color: #f5e0dc;
    }

    li :global(svg) {
        width: 28px;
        height: 28px;
        fill: currentColor;
    }
</style>
